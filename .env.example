# Server Configuration
PORT=3000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/backendDev

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key

# Frontend and Backend URLs
FRONTEND_URL=https://devnet.co.in
BACKEND_URL=https://api.devnet.co.in

# Cloudinary (Media uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Razorpay (Payments)
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=xxxx

# Resend Email Service (3,000 free emails/month - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=DevNet <onboarding@resend.dev> # Or DevNet <notifications@devnet.co.in> after domain verification

# Redis (Optional)
REDIS_URL=redis://localhost:6379

# OpenRouter Free LLM Integration (Get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxx
